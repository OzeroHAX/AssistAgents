{
  "id": "project-brief",
  "passThreshold": 0.75,
  "checks": [
    {
      "id": "mentions_brief_path",
      "kind": "regex_any",
      "weight": 2,
      "description": "Mentions the brief artifact path",
      "patterns": ["brief\\.md", "ai-docs/project/brief\\.md"]
    },
    {
      "id": "mentions_status_path",
      "kind": "regex_any",
      "weight": 1,
      "description": "Mentions the status artifact path",
      "patterns": ["status\\.json", "ai-docs/project/status\\.json"]
    },
    {
      "id": "mentions_repo_context",
      "kind": "regex_any",
      "weight": 1,
      "description": "Mentions the repository context as an API or auth-related project",
      "patterns": ["api", "auth", "session", "авторизац", "аутентификац", "сесс"]
    },
    {
      "id": "not_too_short",
      "kind": "min_length",
      "weight": 1,
      "description": "The response is not trivial",
      "min": 80
    }
  ]
}
