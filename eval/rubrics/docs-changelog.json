{
  "id": "docs-changelog",
  "passThreshold": 0.75,
  "checks": [
    {
      "id": "mentions_fast_replace",
      "kind": "regex_any",
      "weight": 2,
      "description": "Mentions the fast-replace mode by name",
      "patterns": ["fast-replace"]
    },
    {
      "id": "mentions_non_interactive",
      "kind": "regex_any",
      "weight": 1,
      "description": "Mentions skipped prompts or non-interactive behavior",
      "patterns": ["skip(s|ped)? interactive", "without prompts", "без .*вопрос", "без .*подтвержден"]
    },
    {
      "id": "mentions_backup",
      "kind": "regex_any",
      "weight": 1,
      "description": "Mentions automatic backup behavior",
      "patterns": ["auto(matic)? backup", "backup .* before", "архив", "резервн"]
    },
    {
      "id": "not_too_short",
      "kind": "min_length",
      "weight": 1,
      "description": "The note is not empty or trivial",
      "min": 60
    }
  ]
}
